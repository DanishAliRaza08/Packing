# Settings for the website. On Hostinger, add these in hPanel → your Node.js app → Environment variables.
# On your own computer, copy this file to .env and fill it in. Never commit or upload .env with real passwords.

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me

# Password for /admin/. Admin is switched off while this is empty.
ADMIN_PASSWORD=

# Where new quote requests are emailed (defaults to contact.email in src/content/site.json)
NOTIFY_EMAIL=hello@freestylepacking.shop

# SMTP for sending emails. For Hostinger email: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465,
# SMTP_USER and MAIL_FROM = your mailbox (e.g. hello@freestylepacking.shop), SMTP_PASSWORD = its password.
# Leave SMTP_HOST empty to only log emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hello@freestylepacking.shop

# Where quote requests (quotes.json) and uploaded artwork are stored. Defaults to the data/ folder.
# DATA_DIR=data

# Form rate limit: max submissions per visitor per window (seconds)
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=600

# Number of proxies in front of the app (Hostinger: 1). Needed for real visitor IPs and secure cookies.
TRUST_PROXY=1

# The port is set by Hostinger automatically. Locally it defaults to 3000.
# PORT=3000
