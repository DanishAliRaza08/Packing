# Copy this file to .env and fill it in. Never commit .env.

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Password for /admin. Admin is switched off while this is empty.
ADMIN_PASSWORD=

# Where new quote requests are emailed (defaults to contact.email in app/content/site.json)
NOTIFY_EMAIL=you@example.com

# SMTP for sending emails (e.g. Zoho, Google Workspace, Brevo). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hello@example.com

# Storage (defaults to the instance/ folder)
# DATABASE_PATH=instance/quotes.db
# UPLOAD_DIR=instance/uploads

# Form rate limit: max submissions per IP per window (seconds)
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=600

# Set to 1 when running behind a proxy (Render, Railway, Nginx) so the real visitor IP is used
TRUST_PROXY=1

# Set to 0 only for local development over plain http
SESSION_COOKIE_SECURE=1
